# Studio API environment variables — copy to .env for local runs.
# Nothing here is required to boot the service; every omitted value degrades
# in the way described in package.json/README rather than crashing.

# --- server ---
PORT=5000
# Where videos, movies and synthesized music are written. Dockerfile sets /data.
WORK_DIR=./data
# Public base URL used to build /media/:id links in responses.
PUBLIC_BASE_URL=https://studio-api-nqpm.onrender.com

# --- database (strongly recommended) ---
# Postgres connection string. Without it developer keys are memory-only (lost on
# restart), usage counters reset, and the movie asset mirror is unavailable.
DATABASE_URL=

# --- image generation ---
# Primary: Cloudflare Workers AI. Token needs the "Workers AI: Read" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional; defaults to @cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_MODEL=

# --- LLM (required for /v1/content/generate and the movie orchestrator) ---
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b
GROQ_MODEL=

# --- image-to-video animation ---
# Without either key, animation falls back to a Ken Burns pan/zoom on the still.
FAL_KEY=
REPLICATE_API_TOKEN=
# Optional; pins a single model instead of the default kling -> hailuo -> wan order.
I2V_MODEL=

# --- companion Ilm API ---
ILM_API_URL=https://ilm-api.vercel.app
ILM_API_KEY=

# --- quotas and costs ---
FREE_MONTHLY_LIMIT=100
MOVIE_USAGE_COST=20
MOVIE_DAILY_LIMIT=3
MOVIE_MAX_SCENES=12
MOVIE_ASSET_MAX_BYTES=67108864
DUB_USAGE_COST=10

# --- abuse brake on unauthenticated key minting ---
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_MS=3600000
